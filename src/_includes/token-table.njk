{# Renders one generated token table. Expects `table` from the tokens global. #}
<div class="d-flex flex-wrap align-items-center gap-3 mb-4">
  <label class="visually-hidden" for="search-{{ table.id }}">Filter {{ table.label }}</label>
  <input
    type="search"
    id="search-{{ table.id }}"
    class="form-control token-search"
    placeholder="Filter {{ table.count }} tokens&hellip;"
    data-token-search="{{ table.id }}">
  <span class="token-search__count" data-token-count="{{ table.id }}" aria-live="polite"></span>
</div>

{% for section in table.sections %}
  <section class="mb-5" data-token-section>
    <h3 id="{{ table.id }}-{{ section.label | slugify }}">{{ section.label }}</h3>
    {% if section.guidance %}<p>{{ section.guidance }}</p>{% endif %}

    <div class="table-responsive">
      <table class="table table-sm align-middle token-table">
        <caption class="visually-hidden">{{ section.label }} tokens</caption>
        <thead>
          <tr>
            {% if table.swatch %}<th scope="col">Swatch</th>{% endif %}
            <th scope="col">CSS variable</th>
            <th scope="col">SCSS variable</th>
            <th scope="col">Utility classes</th>
            <th scope="col">Value</th>
            <th scope="col">Notes</th>
          </tr>
        </thead>
        <tbody>
          {% for token in section.tokens %}
            <tr class="token-table__row">
              {% if table.swatch %}
                <td>
                  {# Decorative: the same colour is stated as text in the Value column. #}
                  <span class="token-table__swatch" style="--token-swatch: {{ token.value }}" aria-hidden="true"></span>
                </td>
              {% endif %}
              <td class="token-table__name">
                {% if token.cssVar %}
                  <button type="button" class="token-table__copy" data-copy="var({{ token.cssVar }})">{{ token.cssVar }}</button>
                  {% if token.cssVarScope %}<br><small class="token-table__empty">on {{ token.cssVarScope }}</small>{% endif %}
                {% else %}
                  <span class="token-table__empty" title="Not published as a custom property">&mdash;</span>
                {% endif %}
              </td>
              <td class="token-table__name">
                <button type="button" class="token-table__copy" data-copy="{{ token.scss }}">{{ token.scss }}</button>
              </td>
              <td>
                {% if token.utilities.length %}
                  {% for utility in token.utilities %}<code>{{ utility }}</code>{% if not loop.last %} {% endif %}{% endfor %}
                {% else %}
                  <span class="token-table__empty">&mdash;</span>
                {% endif %}
              </td>
              <td><code>{{ token.value }}</code></td>
              <td class="token-table__notes">
                {% if token.note %}{{ token.note }}{% else %}<span class="token-table__empty">&mdash;</span>{% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
{% endfor %}
